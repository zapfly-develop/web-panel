generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  CUSTOMER
  MERCHANT
  RIDER
  ADMIN
}

enum UserAccessStatus {
  ACTIVE
  BANNED
}

enum PushTokenType {
  EXPO
  WEB_PUSH
}

enum PlanType {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

model User {
  id                           String           @id @default(cuid())
  name                         String?
  email                        String?          @unique
  phone                        String?          @unique
  password                     String?
  termsAcceptedAt              DateTime?
  assistantName                String?
  businessProfile              BusinessProfile  @default(GROCERY)
  closedMessage                String?          @db.Text
  manualStoreClosed            Boolean          @default(false)
  deliveryFeeCents             Int              @default(0)
  dynamicFareBonusCents        Int              @default(200)
  stagnatedTimeoutMinutes      Int              @default(15)
  riderIncidentCooldownMinutes Int              @default(30)
  storeAddress                 String?          @db.Text
  acceptedPaymentMethods       PaymentMethod[]  @default([])
  availableDeliveryTypes       DeliveryType[]   @default([DELIVERY])
  role                         UserRole         @default(CUSTOMER)
  accessStatus                 UserAccessStatus @default(ACTIVE)
  aiMessageLimitOverride       Int?
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt

  bots                      BotAccount[]
  products                  Product[]
  templates                 MessageTemplate[]
  subscription              Subscription?
  transactions              Transaction[]
  whatsappInstances         WhatsappInstance[]
  whatsappCustomers         WhatsappCustomer[]
  orders                    Order[]                         @relation("UserOrders")
  storeAddressDetails       StoreAddress?
  whatsappHandovers         WhatsappHandover[]
  operatingHours            OperatingHour[]                 @relation("SubscriberOperatingHours")
  tags                      Tag[]                           @relation("SubscriberTags")
  productTags               ProductTags[]                   @relation("SubscriberProductTags")
  merchantProfile           Merchant?                       @relation("MerchantUser")
  riderProfile              Rider?                          @relation("RiderUser")
  storeRiders               Rider[]                         @relation("StoreOwnedRiders")
  storeDeliveries           Delivery[]                      @relation("StoreDeliveries")
  deliveryRuns              DeliveryRun[]                   @relation("StoreDeliveryRuns")
  deliveryPayouts           DeliveryPayout[]                @relation("StoreDeliveryPayouts")
  safetyFundCoverages       DeliverySafetyFundCoverage[]    @relation("StoreSafetyFundCoverages")
  pushSubscriptions         PushSubscription[]
  deviceTokens              UserDeviceToken[]
  wallet                    Wallet?
  walletTransactions        WalletTransaction[]
  storeDeliveryRatings      DeliveryRating[]                @relation("StoreDeliveryRatings")
  refreshTokens             RefreshToken[]
  integrationConfigs        IntegrationConfig[]
  warehouses                Warehouse[]
  stockMovements            StockMovement[]
  pickingTasks              PickingTask[]
  packedPickingTasks        PickingTask[]                   @relation("PackingOperator")
  inventoryCycleCounts      InventoryCycleCount[]
  startedCycleCounts        InventoryCycleCount[]           @relation("CycleCountStarter")
  completedCycleCounts      InventoryCycleCount[]           @relation("CycleCountCompleter")
  productMappings           ProductMapping[]
  inboundOrders             InboundOrder[]
  layoutRecommendations     WarehouseLayoutRecommendation[]
  internalTransferTasks     InternalTransferTask[]
  assignedInternalTransfers InternalTransferTask[]          @relation("InternalTransferOperator")
}

model Merchant {
  id                           String          @id @default(cuid())
  userId                       String          @unique
  storeName                    String
  assistantName                String?
  businessProfile              BusinessProfile @default(GROCERY)
  closedMessage                String?         @db.Text
  manualStoreClosed            Boolean         @default(false)
  deliveryFeeCents             Int             @default(0)
  dynamicFareBonusCents        Int             @default(200)
  stagnatedTimeoutMinutes      Int             @default(15)
  riderIncidentCooldownMinutes Int             @default(30)
  storeAddress                 String?         @db.Text
  acceptedPaymentMethods       PaymentMethod[] @default([])
  availableDeliveryTypes       DeliveryType[]  @default([DELIVERY])
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt

  user User @relation("MerchantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeName])
  @@index([businessProfile])
}

model RefreshToken {
  id                  String    @id @default(cuid())
  userId              String
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  ipAddress           String?
  userAgent           String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt, expiresAt])
}

model StoreAddress {
  id               String   @id @default(cuid())
  ownerUserId      String   @unique
  street           String
  number           String
  neighborhood     String?
  complement       String?
  city             String
  state            String
  postalCode       String?
  country          String   @default("BR")
  formattedAddress String   @db.Text
  latitude         Float
  longitude        Float
  h3Index          String?  @db.VarChar(15)
  geocodedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ownerUser User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([city, state])
  @@index([h3Index])
}

model PushSubscription {
  id             String    @id @default(cuid())
  userId         String
  endpoint       String    @unique @db.Text
  p256dh         String    @db.Text
  auth           String    @db.Text
  expirationTime DateTime?
  userAgent      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model UserDeviceToken {
  id             String        @id @default(uuid())
  userId         String
  token          String        @db.Text
  type           PushTokenType
  p256dh         String?       @db.Text
  auth           String?       @db.Text
  expirationTime DateTime?
  userAgent      String?       @db.Text
  deviceId       String?
  platform       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, token])
  @@index([userId, type, updatedAt])
}

model OperatingHour {
  id           String  @id @default(uuid())
  subscriberId String
  dayOfWeek    Int
  openTime     String
  closeTime    String
  isOpen       Boolean @default(true)
  timezone     String  @default("America/Sao_Paulo")

  subscriber User @relation("SubscriberOperatingHours", fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([subscriberId, dayOfWeek])
}

model WhatsappInstance {
  id           String   @id @default(cuid())
  userId       String
  instanceName String
  status       String   @default("DISCONNECTED")
  webhookUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]
  handovers WhatsappHandover[]
  customers WhatsappCustomer[]

  @@unique([userId, instanceName])
  @@index([userId, status])
}

enum WhatsappHandoverStatus {
  OPEN
  RESOLVED
}

model WhatsappHandover {
  id                  String                 @id @default(cuid())
  userId              String
  whatsappInstanceId  String
  chatId              String
  triggerText         String?                @db.Text
  lastCustomerMessage String?                @db.Text
  triggerKeywords     String[]               @default([])
  status              WhatsappHandoverStatus @default(OPEN)
  resolvedAt          DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappInstance WhatsappInstance @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([whatsappInstanceId, chatId, status])
}

model WhatsappCustomer {
  id                 String   @id @default(cuid())
  ownerUserId        String
  whatsappInstanceId String?
  whatsappId         String
  displayName        String?
  lastMessageText    String?  @db.Text
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ownerUser        User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  whatsappInstance WhatsappInstance? @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)

  @@unique([ownerUserId, whatsappId])
  @@index([ownerUserId, lastSeenAt])
  @@index([whatsappInstanceId, lastSeenAt])
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String             @unique
  planType              PlanType           @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)
  startDate             DateTime           @default(now())
  endDate               DateTime?
  graceUntil            DateTime?
  gatewaySubscriptionId String?            @unique
  planPriceCents        Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id                    String            @id @default(cuid())
  userId                String
  subscriptionId        String?
  amountCents           Int
  currency              String            @default("BRL")
  status                TransactionStatus @default(PENDING)
  referenceDate         DateTime          @default(now())
  paidAt                DateTime?
  gatewayReference      String?           @unique
  gatewaySubscriptionId String?
  rawPayload            Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([status, referenceDate])
  @@index([userId, createdAt])
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionCategory {
  DELIVERY_PAYOUT
  DELIVERY_ESCROW
  WITHDRAWAL
  REFUND
}

enum WalletTransactionStatus {
  COMPLETED
  PENDING
  FAILED
}

model Wallet {
  id                 String   @id @default(cuid())
  userId             String   @unique
  balanceCents       Int      @default(0)
  frozenBalanceCents Int      @default(0)
  currency           String   @default("BRL")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([userId])
}

model WalletTransaction {
  id                       String                    @id @default(cuid())
  walletId                 String
  userId                   String
  type                     WalletTransactionType
  category                 WalletTransactionCategory
  status                   WalletTransactionStatus   @default(PENDING)
  amountCents              Int
  currency                 String                    @default("BRL")
  balanceBeforeCents       Int
  balanceAfterCents        Int
  frozenBalanceBeforeCents Int                       @default(0)
  frozenBalanceAfterCents  Int                       @default(0)
  sourceModule             String?
  sourceEvent              String?
  sourceReferenceId        String?
  idempotencyKey           String?                   @unique
  description              String?                   @db.Text
  metadata                 Json?
  processedAt              DateTime?
  failedAt                 DateTime?
  failureReason            String?                   @db.Text
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([userId, category, createdAt])
  @@index([status, createdAt])
  @@index([sourceModule, sourceReferenceId])
}

enum BusinessProfile {
  GROCERY
  RESTAURANT
  SNACK_BAR
  EVENT
}

enum PaymentMethod {
  PIX_ONLINE
  PIX_DELIVERY
  CARD_DELIVERY
  CASH
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

model BotAccount {
  id                     String          @id @default(cuid())
  businessProfile        BusinessProfile @default(GROCERY)
  acceptedPaymentMethods PaymentMethod[] @default([])
  availableDeliveryTypes DeliveryType[]  @default([DELIVERY])
  ownerUserId            String?
  name                   String
  token                  String?         @unique
  webhookSecret          String?
  apiId                  Int?
  apiHash                String?
  businessBotToken       String?
  phoneNumber            String?         @unique
  session                String?         @db.Text
  isUserAccount          Boolean         @default(false)
  isActive               Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  ownerUser         User?                 @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  users             TelegramUser[]
  sales             Sale[]
  messageLogs       MessageLog[]
  chatMessages      ChatMessage[]
  scheduledJobs     ScheduledMessageJob[]
  rules             TimedMessageRule[]
  recurring         RecurringSchedule[]
  pixAudioConfig    PixAudioConfig?
  discountConfig    DiscountConfig?
  dontSellIntervals DontSellInterval[]

  @@index([ownerUserId])
}

model RecurringSchedule {
  id         String  @id @default(cuid())
  botId      String
  templateId String
  hour       Int
  minute     Int
  weekDays   Int[]
  isActive   Boolean @default(true)

  bot      BotAccount      @relation(fields: [botId], references: [id], onDelete: Cascade)
  template MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model TelegramUser {
  id              String    @id @default(cuid())
  botId           String
  chatId          String    @unique
  username        String?
  firstName       String?
  lastName        String?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  isBlocked       Boolean   @default(false)
  isSubscriber    Boolean   @default(false)
  subscriberUntil DateTime?

  bot            BotAccount @relation(fields: [botId], references: [id], onDelete: Cascade)
  telegramUserId String     @unique

  sales         Sale[]
  messageLogs   MessageLog[]
  scheduledJobs ScheduledMessageJob[]

  @@unique([telegramUserId, botId])
  @@index([lastSeenAt])
}

enum MessageTemplateKey {
  WELCOME
  DONT_SELL
  SUBSCRIBER_CONTENT
  TIMED
}

enum MediaType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  COMBO
}

model MessageTemplate {
  id             String             @id @default(cuid())
  ownerUserId    String?
  key            MessageTemplateKey
  title          String
  type           MediaType
  text           String?            @db.Text
  mediaUrl       String?
  tags           String[]           @default([])
  telegramFileId String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  ownerUser     User?                  @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  mediaItems    MessageTemplateMedia[]
  rules         TimedMessageRule[]
  scheduledJobs ScheduledMessageJob[]
  recurring     RecurringSchedule[]

  @@index([ownerUserId])
}

model MessageTemplateMedia {
  id             String    @id @default(cuid())
  templateId     String
  type           MediaType
  url            String
  order          Int       @default(0)
  tags           String[]  @default([])
  telegramFileId String?

  template MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

enum UserSegment {
  NEW_USERS
  ALL
  BUYERS
  NON_BUYERS
}

model TimedMessageRule {
  id                    String                @id @default(cuid())
  botId                 String
  name                  String
  isActive              Boolean               @default(true)
  delaySeconds          Int
  repeatIntervalSeconds Int?
  segment               UserSegment
  templateId            String
  template              MessageTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  bot                   BotAccount            @relation(fields: [botId], references: [id], onDelete: Cascade)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  jobs                  ScheduledMessageJob[]
}

enum JobStatus {
  PENDING
  SENT
  FAILED
  CANCELED
}

model ScheduledMessageJob {
  id             String @id @default(cuid())
  botId          String
  telegramUserId String
  chatId         String
  templateId     String

  bot      BotAccount       @relation(fields: [botId], references: [id], onDelete: Cascade)
  user     TelegramUser     @relation(fields: [telegramUserId, botId], references: [telegramUserId, botId], onDelete: Cascade)
  template MessageTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ruleId   String
  rule     TimedMessageRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  runAt     DateTime
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, runAt])
}

model BusinessConnection {
  id             String   @id @default(cuid())
  connectionId   String   @unique
  botId          String
  userTelegramId String
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
}

enum ProductType {
  ONE_TIME
  SUBSCRIPTION
}

enum StockMovementType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
  LOSS
}

enum StorageLocationType {
  PICKING
  BULK
  RECEIVING
}

enum InboundOrderStatus {
  PENDING_MAPPING
  READY_TO_RECEIVE
  RECEIVED
  CANCELLED
}

enum AbcCurve {
  A
  B
  C
}

enum WarehouseRecommendationStatus {
  PENDING
  CONVERTED
  DISMISSED
}

enum InternalTransferStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Tag {
  id           String @id @default(uuid())
  name         String
  subscriberId String

  subscriber  User          @relation("SubscriberTags", fields: [subscriberId], references: [id], onDelete: Cascade)
  productTags ProductTags[]

  @@unique([subscriberId, name])
  @@index([subscriberId])
}

model Product {
  id                    String      @id @default(cuid())
  ownerUserId           String?
  title                 String
  description           String?
  imageUrl              String?
  priceCents            Int
  promotionalPriceCents Int?
  sku                   String?
  stockQuantity         Int?
  reservedStockQuantity Int         @default(0)
  category              String?
  currency              String      @default("BRL")
  isActive              Boolean     @default(true)
  productType           ProductType @default(ONE_TIME)
  subscriberDays        Int?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  ownerUser             User?                           @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  sales                 Sale[]
  discountConfigs       DiscountConfig[]
  orderItems            OrderItem[]
  productTags           ProductTags[]
  stockMovements        StockMovement[]
  pickingItems          PickingTaskItem[]
  productMappings       ProductMapping[]
  inboundItems          InboundOrderItem[]
  layoutRecommendations WarehouseLayoutRecommendation[]
  internalTransferTasks InternalTransferTask[]

  @@unique([ownerUserId, sku])
  @@index([ownerUserId])
  @@index([ownerUserId, category, isActive])
}

model Warehouse {
  id          String   @id @default(cuid())
  name        String
  ownerUserId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerUser             User                            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  storageLocations      StorageLocation[]
  cycleCounts           InventoryCycleCount[]
  inboundOrders         InboundOrder[]
  layoutRecommendations WarehouseLayoutRecommendation[]
  internalTransferTasks InternalTransferTask[]

  @@index([ownerUserId])
}

model StorageLocation {
  id          String              @id @default(cuid())
  warehouseId String
  aisle       String
  shelf       String
  bin         String
  type        StorageLocationType @default(PICKING)
  code        String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  warehouse                    Warehouse                       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockMovements               StockMovement[]
  pickingItems                 PickingTaskItem[]
  cycleCountLocks              InventoryCycleCountLocation[]
  inboundItems                 InboundOrderItem[]
  currentLayoutRecommendations WarehouseLayoutRecommendation[] @relation("CurrentLayoutLocation")
  idealLayoutRecommendations   WarehouseLayoutRecommendation[] @relation("IdealLayoutLocation")
  transfersFrom                InternalTransferTask[]          @relation("SourceLocation")
  transfersTo                  InternalTransferTask[]          @relation("TargetLocation")

  @@unique([warehouseId, aisle, shelf, bin])
  @@unique([warehouseId, code])
  @@index([warehouseId, type])
  @@index([warehouseId, type, code], map: "StorageLocation_wms_layout_idx")
}

model StockMovement {
  id                String            @id @default(cuid())
  type              StockMovementType
  quantity          Int
  productId         String
  storageLocationId String?
  userId            String
  reason            String?           @db.Text
  pickingTaskItemId String?           @unique
  createdAt         DateTime          @default(now())

  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  storageLocation StorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  pickingTaskItem PickingTaskItem? @relation(fields: [pickingTaskItemId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([storageLocationId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([productId, storageLocationId, type, createdAt], map: "StockMovement_wms_analysis_idx")
  @@index([storageLocationId, productId, type], map: "StockMovement_wms_location_balance_idx")
}

model InventoryCycleCount {
  id            String     @id @default(cuid())
  ownerUserId   String
  warehouseId   String
  status        TaskStatus @default(IN_PROGRESS)
  reason        String?    @db.Text
  startedById   String
  completedById String?
  startedAt     DateTime   @default(now())
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  ownerUser   User                          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  warehouse   Warehouse                     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  startedBy   User                          @relation("CycleCountStarter", fields: [startedById], references: [id], onDelete: Restrict)
  completedBy User?                         @relation("CycleCountCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  locations   InventoryCycleCountLocation[]

  @@index([ownerUserId, status, createdAt])
  @@index([warehouseId, status])
  @@index([startedById])
  @@index([completedById])
}

model InventoryCycleCountLocation {
  id                String     @id @default(cuid())
  cycleCountId      String
  storageLocationId String
  status            TaskStatus @default(IN_PROGRESS)
  lockedAt          DateTime   @default(now())
  countedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  cycleCount      InventoryCycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  storageLocation StorageLocation     @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)

  @@unique([cycleCountId, storageLocationId])
  @@index([storageLocationId, status])
  @@index([cycleCountId, status])
}

model ProductMapping {
  id                  String   @id @default(cuid())
  ownerUserId         String
  providerDocument    String
  providerName        String?
  productProviderCode String
  internalProductId   String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  ownerUser       User    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  internalProduct Product @relation(fields: [internalProductId], references: [id], onDelete: Restrict)

  @@unique([ownerUserId, providerDocument, productProviderCode])
  @@index([ownerUserId, providerDocument])
  @@index([internalProductId])
}

model InboundOrder {
  id               String             @id @default(cuid())
  ownerUserId      String
  warehouseId      String?
  status           InboundOrderStatus @default(PENDING_MAPPING)
  source           String             @default("NFE_XML")
  invoiceAccessKey String?            @unique
  invoiceNumber    String?
  invoiceSeries    String?
  providerDocument String
  providerName     String?
  totalCents       Int                @default(0)
  rawPayload       Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  ownerUser User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  warehouse Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items     InboundOrderItem[]

  @@index([ownerUserId, status, createdAt])
  @@index([providerDocument, createdAt])
}

model InboundOrderItem {
  id                         String   @id @default(cuid())
  inboundOrderId             String
  internalProductId          String?
  suggestedStorageLocationId String?
  providerCode               String
  description                String
  ncm                        String?
  gtin                       String?
  quantity                   Int
  unitValueCents             Int
  totalValueCents            Int
  isMapped                   Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  inboundOrder             InboundOrder     @relation(fields: [inboundOrderId], references: [id], onDelete: Cascade)
  internalProduct          Product?         @relation(fields: [internalProductId], references: [id], onDelete: SetNull)
  suggestedStorageLocation StorageLocation? @relation(fields: [suggestedStorageLocationId], references: [id], onDelete: SetNull)

  @@index([inboundOrderId])
  @@index([internalProductId])
  @@index([suggestedStorageLocationId])
  @@index([providerCode])
}

model WarehouseLayoutRecommendation {
  id                       String                        @id @default(cuid())
  ownerUserId              String
  warehouseId              String
  productId                String
  currentStorageLocationId String?
  idealStorageLocationId   String?
  abcCurve                 AbcCurve
  periodDays               Int
  outbound30               Int                           @default(0)
  outbound60               Int                           @default(0)
  outbound90               Int                           @default(0)
  selectedOutboundQuantity Int                           @default(0)
  totalOutboundQuantity    Int                           @default(0)
  cumulativeShare          Float                         @default(0)
  currentLocationCode      String?
  idealLocationCode        String?
  priorityScore            Int                           @default(0)
  reason                   String?                       @db.Text
  status                   WarehouseRecommendationStatus @default(PENDING)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt

  ownerUser       User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  warehouse       Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product         Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  currentLocation StorageLocation?      @relation("CurrentLayoutLocation", fields: [currentStorageLocationId], references: [id], onDelete: SetNull)
  idealLocation   StorageLocation?      @relation("IdealLayoutLocation", fields: [idealStorageLocationId], references: [id], onDelete: SetNull)
  transferTask    InternalTransferTask?

  @@index([ownerUserId, warehouseId, status, createdAt])
  @@index([warehouseId, abcCurve, priorityScore])
  @@index([productId, periodDays])
  @@index([idealStorageLocationId])
}

model InternalTransferTask {
  id                 String                 @id @default(uuid())
  ownerUserId        String
  warehouseId        String
  recommendationId   String?                @unique
  productId          String
  sourceLocationId   String
  targetLocationId   String
  quantity           Int                    @default(1)
  status             InternalTransferStatus @default(PENDING)
  assignedOperatorId String?
  reason             String?                @db.Text
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  startedAt          DateTime?
  completedAt        DateTime?

  ownerUser        User                           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  warehouse        Warehouse                      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  recommendation   WarehouseLayoutRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  product          Product                        @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceLocation   StorageLocation                @relation("SourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  targetLocation   StorageLocation                @relation("TargetLocation", fields: [targetLocationId], references: [id], onDelete: Restrict)
  assignedOperator User?                          @relation("InternalTransferOperator", fields: [assignedOperatorId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, status])
  @@index([ownerUserId, warehouseId, status, createdAt])
  @@index([productId, status])
  @@index([targetLocationId])
  @@index([sourceLocationId])
  @@index([assignedOperatorId])
}

model ProductTags {
  productId    String
  tagId        String
  subscriberId String

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag        Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  subscriber User    @relation("SubscriberProductTags", fields: [subscriberId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([subscriberId, productId])
  @@index([subscriberId, tagId])
  @@index([tagId])
}

enum OrderStatus {
  PENDING
  PREPARING
  READY_FOR_SHIPPING
  READY_FOR_DELIVERY
  SHIPPED
  DELIVERED
}

enum OrderSource {
  FLOOVI_WHATSAPP
  TRAY
  NUVEMSHOP
  UAPPI
  OLIST
  MERCADOLIVRE
}

enum RiderStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum RiderAvailabilityStatus {
  OFFLINE
  AVAILABLE
  BUSY
}

enum RiderVehicleType {
  MOTORCYCLE
  BICYCLE
  CAR
  OTHER
}

enum DeliveryStatus {
  WAITING_RIDER
  READY_FOR_PICKUP
  INCIDENT_REPORTED
  DELIVERY_STAGNATED
  ARRIVED_AT_DESTINATION
  ABSENT_WAITING
  RETURNING_TO_MERCHANT
  PENDING_ASSIGNMENT
  ASSIGNED
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELED
}

enum DeliveryRunStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum DeliveryEventType {
  CLIENT_ABSENT_REPORTED
  RIDER_STALLED_WARNING
  RIDER_STALLED_UNASSIGNED
}

enum DeliveryPaymentHandledBy {
  RIDER
  STORE_MACHINE
}

enum DeliveryAssignmentType {
  MARKETPLACE
  STORE_OWNED
  MANUAL
}

enum DeliveryPayoutStatus {
