}

model Order {
  id                   String         @id @default(cuid())
  ownerUserId          String?
  whatsappInstanceId   String?
  source               OrderSource    @default(FLOOVI_WHATSAPP)
  externalOrderId      String?
  externalOrderNumber  String?
  customerWhatsappId   String
  customerName         String?
  customerEmail        String?
  customerDocument     String?
  customerPhone        String?
  status               OrderStatus    @default(PENDING)
  paymentMethod        PaymentMethod?
  paymentStatus        String         @default("PENDING")
  deliveryType         DeliveryType?
  changeAmount         Float?
  pixPayload           String?        @db.Text
  subtotalCents        Int            @default(0)
  discountCents        Int            @default(0)
  externalShippingFee  Int            @default(0)
  flooviDeliveryFee    Int            @default(0)
  deliveryFeeCents     Int            @default(0)
  totalCents           Int
  currency             String         @default("BRL")
  deliveryAddress      String
  deliveryStreet       String?
  deliveryNumber       String?
  deliveryNeighborhood String?
  deliveryCity         String?
  deliveryState        String?
  deliveryZipCode      String?
  deliveryLatitude     Float?
  deliveryLongitude    Float?
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  ownerUser          User?               @relation("UserOrders", fields: [ownerUserId], references: [id], onDelete: SetNull)
  whatsappInstance   WhatsappInstance?   @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  delivery           Delivery?
  pickingTask        PickingTask?
  deliveryRunPackage DeliveryRunPackage?

  @@unique([ownerUserId, source, externalOrderId])
  @@index([ownerUserId, status, createdAt])
  @@index([whatsappInstanceId, customerWhatsappId, createdAt])
  @@index([source])
  @@index([externalOrderId])
}

model Rider {
  id                   String                  @id @default(cuid())
  userId               String                  @unique
  ownerUserId          String?
  displayName          String?
  documentNumber       String?                 @unique
  cnhNumber            String?                 @unique
  vehicleType          RiderVehicleType        @default(MOTORCYCLE)
  vehiclePlate         String?
  status               RiderStatus             @default(PENDING_REVIEW)
  availabilityStatus   RiderAvailabilityStatus @default(OFFLINE)
  isStoreOwned         Boolean                 @default(false)
  currentLatitude      Float?
  currentLongitude     Float?
  lastLocationAt       DateTime?
  incidentBlockedUntil DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  user         User               @relation("RiderUser", fields: [userId], references: [id], onDelete: Cascade)
  ownerUser    User?              @relation("StoreOwnedRiders", fields: [ownerUserId], references: [id], onDelete: SetNull)
  deliveries   Delivery[]
  deliveryRuns DeliveryRun[]
  locations    DeliveryLocation[]
  incidents    DeliveryIncident[]
  payouts      DeliveryPayout[]
  events       DeliveryEvent[]
  ratings      DeliveryRating[]

  @@index([ownerUserId, status])
  @@index([availabilityStatus, status])
  @@index([incidentBlockedUntil])
  @@index([vehiclePlate])
}

model Delivery {
  id                             String                   @id @default(cuid())
  ownerUserId                    String
  orderId                        String                   @unique
  riderId                        String?
  status                         DeliveryStatus           @default(WAITING_RIDER)
  assignmentType                 DeliveryAssignmentType   @default(MARKETPLACE)
  paymentHandledBy               DeliveryPaymentHandledBy @default(RIDER)
  orderTotalCollectedByStore     Boolean                  @default(false)
  distanceMeters                 Int?
  quotedPriceCents               Int                      @default(0)
  riderPayoutCents               Int                      @default(0)
  isHighPriority                 Boolean                  @default(false) @map("is_high_priority")
  deliveryBonusApplied           Boolean                  @default(false)
  bonusValueCents                Int                      @default(0)
  currency                       String                   @default("BRL")
  pickupAddress                  String?                  @db.Text
  pickupLatitude                 Float?
  pickupLongitude                Float?
  destinationAddress             String                   @db.Text
  destinationLatitude            Float?
  destinationLongitude           Float?
  h3Index                        String?                  @db.VarChar(15)
  acceptedAt                     DateTime?
  acceptedLatitude               Float?                   @map("accepted_latitude")
  acceptedLongitude              Float?                   @map("accepted_longitude")
  pickedUpAt                     DateTime?
  absentClientAt                 DateTime?                @map("absent_client_at")
  deliveryFeeEscrowedAt          DateTime?                @map("delivery_fee_escrowed_at")
  deliveryFeeEscrowCents         Int                      @default(0) @map("delivery_fee_escrow_cents")
  deliveryFeeEscrowTransactionId String?                  @unique @map("delivery_fee_escrow_transaction_id")
  deliveredAt                    DateTime?
  canceledAt                     DateTime?
  cancellationReason             String?                  @db.Text
  riderSearchStartedAt           DateTime                 @default(now()) @map("rider_search_started_at")
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt

  ownerUser          User                        @relation("StoreDeliveries", fields: [ownerUserId], references: [id], onDelete: Cascade)
  order              Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider              Rider?                      @relation(fields: [riderId], references: [id], onDelete: SetNull)
  locations          DeliveryLocation[]
  incidents          DeliveryIncident[]
  events             DeliveryEvent[]
  payout             DeliveryPayout?
  safetyFundCoverage DeliverySafetyFundCoverage?
  rating             DeliveryRating?
  runPackage         DeliveryRunPackage?

  @@index([ownerUserId, status, createdAt])
  @@index([riderId, status])
  @@index([assignmentType, status])
  @@index([status, isHighPriority, updatedAt])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([h3Index])
}

model DeliveryRun {
  id            String            @id @default(cuid())
  ownerUserId   String
  riderId       String?
  zone          String
  status        DeliveryRunStatus @default(PENDING_ASSIGNMENT)
  packageCount  Int               @default(0)
  totalVolume   Int               @default(0)
  priorityScore Int               @default(0)
  assignedAt    DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  ownerUser User                 @relation("StoreDeliveryRuns", fields: [ownerUserId], references: [id], onDelete: Cascade)
  rider     Rider?               @relation(fields: [riderId], references: [id], onDelete: SetNull)
  packages  DeliveryRunPackage[]

  @@index([ownerUserId, status, zone, createdAt])
  @@index([riderId, status])
  @@index([zone, status])
}

model DeliveryRunPackage {
  id            String   @id @default(cuid())
  deliveryRunId String
  deliveryId    String   @unique
  orderId       String   @unique
  packageCode   String?
  volumeUnits   Int      @default(1)
  priorityScore Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deliveryRun DeliveryRun @relation(fields: [deliveryRunId], references: [id], onDelete: Cascade)
  delivery    Delivery    @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([deliveryRunId, createdAt])
  @@index([priorityScore])
}

model DeliveryRating {
  id                 String   @id @default(cuid())
  deliveryId         String   @unique
  riderId            String
  ownerUserId        String
  customerWhatsappId String?
  score              Int
  comment            String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  delivery  Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  ownerUser User     @relation("StoreDeliveryRatings", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([riderId, createdAt])
  @@index([ownerUserId, createdAt])
  @@index([score])
}

model DeliveryIncident {
  id          String   @id @default(cuid())
  deliveryId  String
  riderId     String
  reason      String   @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  rider    Rider    @relation(fields: [riderId], references: [id], onDelete: Restrict)

  @@index([deliveryId, createdAt])
  @@index([riderId, createdAt])
}

model DeliveryEvent {
  id          String            @id @default(cuid())
  deliveryId  String
  riderId     String?
  eventType   DeliveryEventType
  description String?           @db.Text
  metadata    Json?
  createdAt   DateTime          @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  rider    Rider?   @relation(fields: [riderId], references: [id], onDelete: SetNull)

  @@index([deliveryId, createdAt])
  @@index([riderId, createdAt])
  @@index([eventType, createdAt])
}

model DeliveryLocation {
  id             String   @id @default(cuid())
  deliveryId     String
  riderId        String?
  latitude       Float
  longitude      Float
  h3Index        String?  @db.VarChar(15)
  accuracyMeters Float?
  recordedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  rider    Rider?   @relation(fields: [riderId], references: [id], onDelete: SetNull)

  @@index([deliveryId, recordedAt])
  @@index([riderId, recordedAt])
  @@index([h3Index])
}

model DeliveryPayout {
  id                 String                       @id @default(cuid())
  deliveryId         String                       @unique
  riderId            String
  ownerUserId        String
  amountCents        Int
  deliveryFeeCents   Int                          @default(0)
  riderProfitCents   Int                          @default(0)
  storeDebitCents    Int                          @default(0)
  riderRetainedCents Int                          @default(0)
  settlementType     DeliveryPayoutSettlementType @default(STORE_DEBIT)
  currency           String                       @default("BRL")
  status             DeliveryPayoutStatus         @default(PENDING)
  processedAt        DateTime?
  failureReason      String?                      @db.Text
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  delivery  Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  ownerUser User     @relation("StoreDeliveryPayouts", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([riderId, status, createdAt])
  @@index([riderId, status, processedAt])
  @@index([ownerUserId, status, createdAt])
}

model DeliverySafetyFundCoverage {
  id            String   @id @default(cuid())
  ownerUserId   String
  deliveryId    String   @unique
  coverageMonth String
  amountCents   Int
  currency      String   @default("BRL")
  createdAt     DateTime @default(now())

  ownerUser User     @relation("StoreSafetyFundCoverages", fields: [ownerUserId], references: [id], onDelete: Cascade)
  delivery  Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, coverageMonth])
  @@index([ownerUserId, createdAt])
}

model OrderItem {
