# Banco / Prisma Client
DATABASE_URL="postgresql://user:password@localhost:5432/database?schema=public"
PRISMA_CLIENT_OUTPUT=

# Next/Auth
APP_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Back-end Nest
# Server-side do Next chama esta URL.
NEST_API_URL=http://localhost:3001

# Browser chama esta URL para HTTP/Socket.IO.
# Para testar PWA em celular, use http://SEU_IP_LOCAL:3001.
NEXT_PUBLIC_NEST_API_URL=http://localhost:3001

# Google Maps usado no mapa operacional dos riders.
# Restrinja esta chave por dominio no Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cron
CRON_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SERVICE_URL=http://localhost:3001
TELEGRAM_SERVICE_SECRET=

# SyncPay
SYNCPAY_API_URL=https://api.syncpayments.com.br
SYNCPAY_CLIENT_ID=
SYNCPAY_CLIENT_SECRET=
SYNCPAY_STATIC_KEY=
SYNCPAY_DEFAULT_CPF=
SYNCPAY_DEFAULT_EMAIL=
SYNCPAY_DEFAULT_PHONE=
SYNCPAY_WEBHOOK_SECRET=
SYNCPAY_WEBHOOK_URL=

# Upload / storage local
FILE_STORAGE_DRIVER=local
FILE_STORAGE_LOCAL_PUBLIC_ROOT=uploads
PRODUCT_IMAGE_UPLOAD_MAX_MB=5

# Upload / S3 compativel
FILE_STORAGE_S3_REGION=
FILE_STORAGE_S3_BUCKET=
FILE_STORAGE_S3_ENDPOINT=
FILE_STORAGE_S3_ACCESS_KEY_ID=
FILE_STORAGE_S3_SECRET_ACCESS_KEY=
FILE_STORAGE_S3_PUBLIC_BASE_URL=
FILE_STORAGE_S3_FORCE_PATH_STYLE=false

# Vercel Blob legado
BLOB_READ_WRITE_TOKEN=
